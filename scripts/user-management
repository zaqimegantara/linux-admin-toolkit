#!/usr/bin/env bash

action="$1"
username="$2"

if [[ -z "$action" || -z "$username" ]]; then
    echo "Usage: $0 {create|delete|disable|enable} USERNAME" >&2
    exit 1
fi

case "$action" in
    create)
        echo "Creating $username"
        ;;
    delete)
        echo "Deleting $username"
        ;;
    disable)
        echo "Disabling $username"
        ;;
    enable)
        echo "Enabling $username"
        ;;
    *)
        echo "Invalid action: $action" >&2
        exit 1
        ;;
esac

if [[ ! "$username" =~ ^[a-z][a-z0-9_-]*$ ]]; then
    echo "Error: Invalid username '$username'" >&2
    echo "Username must start with a lowercase letter and contain only lowercase letters, numbers, _ or -." >&2
    exit 1
fi

if [[ "$EUID" -ne 0 ]]; then
	echo "Error : this script must be run as root." >&2
	exit 1
fi

if getent passwd "$username" > /dev/null; then
    echo "User already exists"
    exit 1
fi

echo "Action: $action"
echo "Username: $username"
